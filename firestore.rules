rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.matches('(?i)^(blackswan202614@gmail\\.com|germanmountrichas@gmail\\.com)$') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Connection test document
    match /test/connection {
      allow get: if true;
    }

    // Admins registry
    match /admins/{adminId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Brands & Models Catalog
    match /brands/{brandId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // System Config & Production Metadata
    match /system/{docId} {
      allow get, list, write: if true;
    }

    // Vehicle Inventory Collection - Full access for all administrators
    match /cars/{carId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Inquiries Collection (Customer Leads)
    match /inquiries/{inquiryId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Customers CRM Collection
    match /customers/{customerId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Quotations Collection
    match /quotations/{quotationId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    // Expenses & Finance Collection (Sector Finanzas & Gastos)
    match /expenses/{expenseId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }
  }
}
